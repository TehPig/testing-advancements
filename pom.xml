<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.tehcraftsmp</groupId>
    <artifactId>Testing-Advancements</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Testing-Advancements</name>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Debug Mode Default -->
        <debug.mode>false</debug.mode>

        <!-- Defaults when no profile active -->
        <!--        <server.channel.url>REPLACE_ME</server.channel.url>-->
        <!--        <server.status.url>REPLACE_ME</server.status.url>-->
        <!--        <server.status.msg.id>0</server.status.msg.id>-->

        <!-- Destination for built jar -->
        <plugins.dir>C:/Users/TehPig/Desktop/@Testing Server/plugins</plugins.dir>
    </properties>

    <build>
        <defaultGoal>clean package</defaultGoal>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- Disable the default main jar so only profile jars are produced -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>


        </plugins>
    </build>

    <profiles>
        <profile>
            <id>production</id>
            <properties>
                <debug.mode>false</debug.mode>
                <!--                <server.channel.url>https://discord.com/api/webhooks/1426782371180707942/Ups8NMGLDSiW2BytqS1SSON6Cqkd1Vt8DtcdCKTaBgKw7boIKz5rMLqEqTaxvF1a5rbM</server.channel.url>-->
                <!--                <server.status.url>https://discord.com/api/webhooks/1431824457697198202/c0pqclgj34knPre0M8BCWG4NxstOslAAo-NPb-YknmHORTSTiRBpHkskuC-PhlnKfFeI</server.status.url>-->
                <!--                <server.status.msg.id>1431828991467327488</server.status.msg.id>-->
            </properties>
            <build>
                <plugins>
                    <!-- Produce only a shaded jar with classifier 'production' -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.3</version>
                        <executions>
                            <execution>
                                <id>shade-production</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <shadedArtifactAttached>true</shadedArtifactAttached>
                                    <shadedClassifierName>production</shadedClassifierName>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <minimizeJar>false</minimizeJar>
                                    <relocations>
                                        <relocation>
                                            <pattern>com.fren_gor.ultimateAdvancementAPI</pattern>
                                            <shadedPattern>org.tehcraftsmp.testingAdvancements.libs.com.fren_gor.ultimateAdvancementAPI</shadedPattern>
                                        </relocation>
                                    </relocations>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- maven-antrun-plugin for production -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>copy-production-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${plugins.dir}"/>
                                        <copy todir="${plugins.dir}" overwrite="true" verbose="true">
                                            <fileset dir="${project.build.directory}">
                                                <include
                                                        name="*${project.artifactId}-${project.version}-production.jar"/>
                                            </fileset>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>testing</id>
            <properties>
                <debug.mode>true</debug.mode>
                <!--                <server.channel.url>https://discord.com/api/webhooks/1431983206797807747/4FDPoxCWubQIYIlz4V4zcH6h45Gff3vGIgyfieF8HAyIhy9A9asKc44lW4Dwbx7jPKGE</server.channel.url>-->
                <!--                <server.status.url>https://discord.com/api/webhooks/1431834379440619593/a-XawVSVjDBtbdHEcSQi5TPxbgB4_L1bXe5-mjSYhuT4SOD8grjLTwkRtN_884bl73Gj</server.status.url>-->
                <!--                <server.status.msg.id>1431834676401541140</server.status.msg.id>-->
            </properties>
            <build>
                <plugins>
                    <!-- Produce only a shaded jar with classifier 'testing' -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.3</version>
                        <executions>
                            <execution>
                                <id>shade-testing</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <shadedArtifactAttached>true</shadedArtifactAttached>
                                    <shadedClassifierName>testing</shadedClassifierName>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <minimizeJar>false</minimizeJar>
                                    <relocations>
                                        <relocation>
                                            <pattern>com.fren_gor.ultimateAdvancementAPI</pattern>
                                            <shadedPattern>org.tehcraftsmp.testingAdvancements.libs.com.fren_gor.ultimateAdvancementAPI</shadedPattern>
                                        </relocation>
                                    </relocations>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- maven-antrun-plugin for testing -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>copy-testing-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${plugins.dir}"/>
                                        <copy todir="${plugins.dir}" overwrite="true" verbose="true">
                                            <fileset dir="${project.build.directory}">
                                                <include name="*${project.artifactId}-${project.version}-testing.jar"/>
                                            </fileset>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>fren_gor</id>
            <url>https://nexus.frengor.com/repository/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- HikariCP for connection pooling -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- Advancement API-->
        <dependency>
            <groupId>com.frengor</groupId>
            <artifactId>ultimateadvancementapi-shadeable</artifactId>
            <version>3.0.0-beta-1</version>
            <classifier>mojang-mapped</classifier>
            <scope>compile</scope>
        </dependency>
        <!-- SQLite JDBC Driver -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.1.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
